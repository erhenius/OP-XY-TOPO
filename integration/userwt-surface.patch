+    if (!out || track >= kTracksOverviewed || bits < 8 || bits > 11 || warp > 32767 ||
+        !shown_key || !overview.loaded || overview.end <= overview.begin || overview.end > overview.frames)
+        return false;
+    const u32 count = overview.end - overview.begin;
