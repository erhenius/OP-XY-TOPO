new file mode 100644
index 00000000..c21106d1
--- /dev/null
+++ b/sdk/include/opxy/wavetable_surface.hpp
@@ -0,0 +1,22 @@
+#pragma once
+#include <opxy/types.hpp>
+
+namespace opxy { namespace draw {
+const u32 surface_rows = 32, surface_intervals = 32;
+struct TableSurface {
+    u32 rows;
+    i16 heights[surface_rows][surface_intervals + 1];
+};
+// The bank's first cycle is at the near left, its last at the far right.
+inline u32 surface_cycle(u32 row, u32 rows, u32 cycles) {
+    return rows == 1 ? 0 : (row * (cycles - 1) + (rows - 1) / 2) / (rows - 1);
+}
+struct SurfacePoint { i32 x, y; };
+inline SurfacePoint surface_point(const i16* heights, u32 i) {
+    const bool floor = i > surface_intervals;
+    const i32 col = floor ? (i == surface_intervals + 1 ? surface_intervals : 0) : i;
+    return {col * 9 * 1024, (floor ? 32 * 1024 : -i32(heights[col]) * 29 / 32) - col * 384};
+}
+}}
+extern "C" bool opxy_userwt_surface(opxy::u32 track, opxy::u32 bits, opxy::u32 warp,
+                                    opxy::draw::TableSurface* out);
