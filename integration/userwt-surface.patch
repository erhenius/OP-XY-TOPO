+// A table screen opts in by returning newly published geometry. Its nodes
+// belong to the SVG object and are redrawn through the normal screen pass.
+template<class S, class O> auto apply_table_surface(const S& state, O* o, int)
+    -> decltype(changed_table_surface(state), void()) {
+    const draw::TableSurface* table = changed_table_surface(state);
+    if (!table) return;
+    const u32 points = draw::surface_intervals + 3;
+    using Outline = RetainedDrawing<draw::Frame<1, points, 1, 0, 1>>;
+    for (u32 row = 0; row < table->rows; ++row) {
+        PathNode* node = o->nodes[row];
+        const u32 address = Outline::geometry(node);
+        if (!address) continue;
+        Command* commands = reinterpret_cast<Command*>(address);
+        for (u32 i = 0; i < points; ++i) {
+            const draw::SurfacePoint pt = draw::surface_point(table->heights[row], i);
+            commands[i].x = pt.x;
+            commands[i].y = pt.y;
+        }
+        invalidate(node);
+    }
+}
+template<class S, class O> void apply_table_surface(const S&, O*, ...) {}
