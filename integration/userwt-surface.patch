diff --git a/sdk/platform/opxy-1.2.1/wavetable_surface_cache.hpp b/sdk/platform/opxy-1.2.1/wavetable_surface_cache.hpp
new file mode 100644
index 00000000..cc840954
--- /dev/null
+++ b/sdk/platform/opxy-1.2.1/wavetable_surface_cache.hpp
@@ -0,0 +1,73 @@
+#pragma once
+#include <opxy/wavetable_surface.hpp>
+#include <opxy/sample.hpp>
+#include "barrier.hpp"
+
+namespace opxy { namespace platform {
+struct SurfaceCache {
+    volatile u32 request, completed, publishing;
+    volatile u32 track, key, generation, first, frames, bits, warp, reverse;
+    volatile i16 heights[draw::surface_rows][draw::surface_intervals + 1];
+    volatile u32 rows;
+
+    bool want(u32 t, u32 k, u32 g, u32 begin, u32 length, u32 b, u32 bend, bool rev) {
+        if (request && track == t && key == k && generation == g && first == begin &&
+            frames == length && bits == b && warp == bend && reverse == u32(rev)) return false;
+        ++request;
+        barrier();
+        track = t; key = k; generation = g; first = begin; frames = length;
+        bits = b; warp = bend; reverse = rev;
+        barrier();
+        if (!++request) request = 2;
+        barrier();
+        return true;
+    }
+    void prepare(u32 t, u32 k, u32 g, const SampleView& view) {
+        const u32 ticket = request;
+        barrier();
+        if (!ticket || (ticket & 1) || completed == ticket || track != t || key != k || generation != g) return;
+        const u32 start = first, count = frames, b = bits, bend = warp, rev = reverse;
+        barrier();
+        if (request != ticket || !view.data || (view.channels != 1 && view.channels != 2) ||
+            b < 8 || b > 11 || bend > 32767 || start > view.frames || count > view.frames - start ||
+            start + count > 0xffffffffu / view.channels) return;
+        const u32 width = 1u << b, mask = width - 1, cycles = count >> b;
+        if (!cycles || (count & mask)) return;
+        const u32 n = cycles < draw::surface_rows ? cycles : draw::surface_rows;
+        ++publishing;
+        barrier();
+        for (u32 row = 0; row < n; ++row) {
+            const u32 index = draw::surface_cycle(row, n, cycles);
+            const i16* pcm = view.data + (start + index * width) * view.channels;
+            for (u32 col = 0; col < draw::surface_intervals; ++col) {
+                u32 phase = col << 27;
+                if (rev) phase = 0u - phase;
+                phase += ((phase < 0x80000000u ? phase : 0u - phase) >> 16) * bend;
+                const u32 x = phase >> (32 - b), frac = (phase >> (17 - b)) & 32767;
+                const i32 a = pcm[x * view.channels], z = pcm[((x + 1) & mask) * view.channels];
+                heights[row][col] = i16(a + ((z - a) * i32(frac) >> 15));
+            }
+            heights[row][draw::surface_intervals] = heights[row][0];
+        }
+        rows = n;
+        barrier();
+        completed = ticket;
+        barrier();
+        ++publishing;
+    }
+    bool copy(draw::TableSurface& dest) const {
+        const u32 version = publishing;
+        barrier();
+        if ((version & 1) || !request || completed != request) return false;
+        const u32 n = rows;
+        if (!n || n > draw::surface_rows) return false;
+        for (u32 row = 0; row < n; ++row)
+            for (u32 col = 0; col <= draw::surface_intervals; ++col)
+                dest.heights[row][col] = heights[row][col];
+        barrier();
+        if (publishing != version || completed != request) return false;
+        dest.rows = n;
+        return true;
+    }
+};
+}}
